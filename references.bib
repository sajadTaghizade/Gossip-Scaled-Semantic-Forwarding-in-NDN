% -- The bias our refusal-reason result is an instance of ---------------------
% Learning from feedback that is only observed for the items the system chose
% to act on, where the choice and the outcome share a cause, is missing-not-at-
% random / exposure bias. Our contribution is locating one in an NDN forwarding
% plane and naming its mechanism, not discovering the pattern.

@inproceedings{saito2020unbiased,
  author    = {Yuta Saito and Suguru Yaginuma and Yuta Nishino and Hayato Sakata and Kazuhide Nakata},
  title     = {Unbiased Recommender Learning from Missing-Not-At-Random Implicit Feedback},
  booktitle = {Proceedings of the 13th ACM International Conference on Web Search and Data Mining (WSDM)},
  year      = {2020},
  url       = {https://arxiv.org/abs/1909.03601}
}

